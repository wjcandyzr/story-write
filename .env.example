NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=novel
DB_PASSWORD=novel_pass
DB_NAME=ai_novel
DB_SYNC=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.8
# 单次非流式 LLM 调用总超时(毫秒) — 用于 plan / compress / continuity / polish / draftOutline
LLM_TIMEOUT_MS=60000
# 流式生成的"卡顿超时":多少毫秒没收到下一个 token 就 abort 上游 HTTP
LLM_STREAM_STALL_MS=45000
# 混合思考模型(如 deepseek-v4-flash)请用 "disabled" 关掉思考,
# 不然流式时 reasoning 不走 content 字段,前端看不到字。
# 只对支持 thinking 字段的模型生效,其他模型留空。
LLM_THINKING=disabled
# 思考模式开启时的努力强度:low | medium | high。LLM_THINKING=disabled 时无效。
# LLM_REASONING_EFFORT=high
# 兼容开关:某些模型(例 deepseek-v4-flash)真正流式跑不通,
# 设为 true 后,后端走非流式 complete() 拉完整文本,再按段落分批
# emit 给前端。前端代码不变,只是前几十秒看不到任何字。
LLM_FAKE_STREAM=true
# 连续性检查的循环修订上限。每轮 1 次 LLM 调用 (~30~60s),3 轮通常够。
# 设为 1 等同旧行为(只修一轮);设为 0 完全禁用自动修订。
LLM_MAX_REWRITES=3

# LangGraph checkpoint (Postgres connection string)
CHECKPOINT_PG_URL=postgres://novel:novel_pass@postgres:5432/ai_novel
