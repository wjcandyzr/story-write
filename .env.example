NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=novel
DB_PASSWORD=novel_pass
DB_NAME=ai_novel
DB_SYNC=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.8

# LangGraph checkpoint (Postgres connection string)
CHECKPOINT_PG_URL=postgres://novel:novel_pass@postgres:5432/ai_novel
